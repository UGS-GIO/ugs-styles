{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-comments.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking comments"
          }
        ]
      }
    ]
  }
}
